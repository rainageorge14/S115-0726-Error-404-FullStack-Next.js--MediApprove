// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum MedicineStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  APPROVED
  REJECTED
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  department String?
  phone      String?
  timeFormat   String @default("12h")
  tokenVersion Int    @default(0)

  auditLogs     AuditLog[]

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@map("Admin")
}

model MedicineListing {
  id           String         @id @default(cuid())
  medicineName String
  sku          String         @unique
  formulation  String
  price        Float
  expiryDate   DateTime
  vendor       String
  status       MedicineStatus @default(PENDING)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  listingId String
  listing   MedicineListing @relation(fields: [listingId], references: [id])

  action AuditAction

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([listingId])
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  isRead Boolean @default(false)

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([adminId])
}
